mixin icon(name)
  case name
    when 'heart'
      svg(viewBox='0 0 24 24' fill='currentColor' aria-hidden='true' focusable='false')&attributes(attributes)
        path(d='M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z')
    when 'menu'
      svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' aria-hidden='true' focusable='false')&attributes(attributes)
        path(d='M3 6h18M3 12h18M3 18h18')
    when 'close'
      svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' aria-hidden='true' focusable='false')&attributes(attributes)
        path(d='M5 5l14 14M19 5L5 19')
    when 'arrow-up'
      svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' aria-hidden='true' focusable='false')&attributes(attributes)
        path(d='M12 20V5M5 11l7-7 7 7')
    when 'mail'
      svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' aria-hidden='true' focusable='false')&attributes(attributes)
        rect(x='2' y='5' width='20' height='14')
        path(d='M2 6l10 8 10-8')