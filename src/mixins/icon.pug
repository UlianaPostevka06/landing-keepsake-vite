mixin icon(name, w = 16, h = 16)
  case name
    when 'heart'
      svg(
        width=w,
        height=h,
        viewBox='0 0 24 24',
        fill='currentColor',
        aria-hidden='true',
        focusable='false'
      )&attributes(attributes)
        path(
          d='M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z'
        )
    when 'mail'
      svg(
        width=w,
        height=h,
        viewBox='0 0 14 11',
        fill='none',
        stroke='currentColor',
        stroke-width='1.2',
        aria-hidden='true',
        focusable='false'
      )&attributes(attributes)
        rect(x='.6', y='.6', width='12.8', height='9.8')
        path(d='M.6 1l6.4 5 6.4-5')
    default
      svg(width=w, height=h, aria-hidden='true', focusable='false')&attributes(attributes)
        use(href=`#icon-${name}`)
