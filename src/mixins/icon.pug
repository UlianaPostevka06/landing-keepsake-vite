mixin icon(name, size = 24)
  svg.icon(width=size height=size viewBox='0 0 24 24' aria-hidden='true' focusable='false')
    case name
      when 'arrow'
        path(d='M5 12h14M13 6l6 6-6 6' fill='none' stroke='currentColor' stroke-width='2')
      when 'instagram'
        rect(x='3' y='3' width='18' height='18' rx='5' fill='none' stroke='currentColor' stroke-width='2')
        circle(cx='12' cy='12' r='4' fill='none' stroke='currentColor' stroke-width='2')
      when 'mail'
        path(d='M3 6h18v12H3zM3 7l9 7 9-7' fill='none' stroke='currentColor' stroke-width='2')
      default
        circle(cx='12' cy='12' r='9' fill='none' stroke='currentColor' stroke-width='2')