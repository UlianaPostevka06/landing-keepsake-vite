mixin work-card(item)
  li.grid__item(data-category=item.category)
    article.card
      a.card__link(href='#')
        +picture(item.image, item.alt, 400, 316, 'card__img')
        .card__overlay
          span.card__plus(aria-hidden='true') +
          h3.card__title= item.title
          span.card__line(aria-hidden='true')
          span.card__cat= item.catLabel
