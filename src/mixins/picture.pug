mixin picture(name, alt = '', width = 400, height = 316, cls = '')
  picture
    source(srcset=`/images/${name}@1x.avif 1x, /images/${name}@2x.avif 2x`, type='image/avif')
    source(srcset=`/images/${name}@1x.webp 1x, /images/${name}@2x.webp 2x`, type='image/webp')
    img(
      class=cls || false,
      src=`/images/${name}@1x.jpg`,
      srcset=`/images/${name}@2x.jpg 2x`,
      width=width,
      height=height,
      alt=alt,
      loading='lazy'
    )
