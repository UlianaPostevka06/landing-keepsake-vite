mixin picture(name, alt = '', width = 400, height = 316, cls = '', sizes = '(min-width: 1280px) 357px, (min-width: 768px) 50vw, 100vw')
  picture
    source(
      srcset=`images/${name}@1x.avif 1x, images/${name}@2x.avif 2x`,
      sizes=sizes,
      type='image/avif'
    )
    source(
      srcset=`images/${name}@1x.webp 1x, images/${name}@2x.webp 2x`,
      sizes=sizes,
      type='image/webp'
    )
    img(
      class=cls || false,
      src=`images/${name}@1x.jpg`,
      srcset=`images/${name}@2x.jpg 2x`,
      sizes=sizes,
      width=width,
      height=height,
      alt=alt,
      loading='lazy',
      decoding='async'
    )
