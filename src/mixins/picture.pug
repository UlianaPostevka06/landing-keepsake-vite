mixin picture(name, alt, w, h, opts = {})
  - const base = `/src/assets/images/${name}`
  - const sizes = opts.sizes || '(min-width: 1280px) 357px, (min-width: 768px) 50vw, 100vw'
  - const eager = opts.eager
  picture
    each fmt in ['avif', 'webp']
      source(type=`image/${fmt}` srcset=`${base}-400.${fmt} 400w, ${base}-800.${fmt} 800w` sizes=sizes)
    img(src=`${base}-800.jpg` alt=alt width=w height=h decoding='async' loading=(eager ? false : 'lazy') fetchpriority=(eager ? 'high' : false))&attributes(attributes)