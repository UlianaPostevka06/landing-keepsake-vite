section#works.section.works(aria-labelledby='works-title')
  .container
    each f, i in filters
      input.filter__input.sr-only(type='radio' name='filter' id=`filter-${f.id}` value=f.id checked=(i === 0))
    .works__head
      h2#works-title.section-title Our awesome works
      .chips(role='group' aria-label='Filter works')
        each f in filters
          label.chip(for=`filter-${f.id}` data-filter=f.id)= f.label
    ul.works-grid
      each work in works
        li.works-grid__item(data-category=work.category)
          +work-card(work)
    .works__more
      +btn('Load more works', '#', 'secondary')