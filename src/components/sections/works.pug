section#works.section.works(aria-labelledby='works-title')
  .container
    each cat in categories
      input.filter__input.sr-only(type='radio', name='filter', id=cat.id, checked=cat.checked || false)

    .works__head
      +section-title('Our awesome works', 'works-title')
      .chips(role='group', aria-label='Filter works')
        each cat in categories
          label.chip(for=cat.id)= cat.title

    ul.works__grid
      each item in works
        +work-card(item)

    .works__more
      +btn('Load more works', '#', 'secondary')
