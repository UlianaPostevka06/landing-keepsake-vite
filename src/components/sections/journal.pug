section#journal.section.journal(aria-labelledby='journal-title')
  .container
    +section-title('From the journal', 'journal-title')
    p.section-lead Notes on process, case studies and things that inspire us.
    .journal__list
      each post in posts
        article.post
          +picture(post.image, '', 150, 150, 'post__img')
          .post__body
            p.post__meta
              time(datetime=post.date)= post.dateText
              = ` / ${post.cat}`
            h3.post__title= post.title
            p.post__text= post.text
            a.post__more(href='#') Read more
