header.header
  .container.header__inner
    a.header__logo(href='#') Keepsake
    nav.nav(aria-label='Головна навігація')
      ul.nav__list
        each item, i in navItems
          li.nav__item
            a.nav__link(href=item.href class={ 'nav__link--active': item.active } aria-current=(item.active ? 'true' : false))= item.title