{
  "name": "landing-keepsake-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.mjs",
    "format": "prettier --plugin=@prettier/plugin-pug --write \"src/**/*.{pug,scss}\"",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "prepare": "husky",
    "lint": "npm run lint:styles && npm run lint:format",
    "lint:format": "prettier --plugin=@prettier/plugin-pug --check \"src/**/*.{pug,scss}\""
  },
  "devDependencies": {
    "@prettier/plugin-pug": "^3.2.0",
    "@vituum/vite-plugin-pug": "^2.0.1",
    "autoprefixer": "^10.4.20",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "sass": "^1.108.2",
    "sharp": "^0.33.5",
    "stylelint": "^16.10.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "vite": "8.3.3",
    "vituum": "^1.2.0"
  },
  "lint-staged": {
    "*.pug": "prettier --write",
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ]
  }
}
